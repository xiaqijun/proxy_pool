# 复制为 .env 后修改，不要提交 .env
# cp .env.example .env

# Redis 密码（生产环境必须修改）
REDIS_PASSWORD=change-me-redis

# 监控工作台登录
MONITOR_AUTH_USER=admin
MONITOR_AUTH_PASSWORD=change-me-dashboard
# 通过 HTTPS 访问工作台时设为 true
MONITOR_COOKIE_SECURE=false

# 网关认证，格式 username:password；公网暴露时必须设置
GATEWAY_AUTH=proxyuser:change-me-gateway

# 代理更换方式
PROXY_STRATEGY=random
GATEWAY_STRATEGY=random

# WAF 检测
WAF_DETECT_ENABLED=true
WAF_SCORE_THRESHOLD=2

# 对外端口（同时作为容器内监听端口）
API_PORT=5010
GATEWAY_PORT=5011

# 可选
TIMEZONE=Asia/Shanghai
MONITOR_RETENTION_DAYS=7
MONITOR_REFRESH_SECONDS=5
